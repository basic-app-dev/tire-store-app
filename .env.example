# ==============================================================================
# Supabase Configuration
# Obtain these from your Supabase Dashboard:
# Project Settings -> API & Project Settings -> Database
# ==============================================================================

# Direct or Transaction Pooler PostgreSQL connection string
# Example: postgres://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase Project API URL (e.g. https://xyzcompany.supabase.co or http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"

# Supabase Anonymous Public API Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Supabase Service Role Secret Key (admin only, server-side only)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ==============================================================================
# Stripe Configuration (Test Mode)
# Obtain these from Stripe Dashboard -> Developers -> API Keys
# ==============================================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

