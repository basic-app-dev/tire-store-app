# ==============================================================================
# Tire Store Platform — Root Git Ignore Configuration
# Layer: Repository-Wide (OS, Editors, Monorepo Tooling, Env, Logs)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 2. General Editor & IDE Artifacts
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, WebStorm, Android Studio)
.idea/
*.iws
*.iml
*.ipr

# Visual Studio Code local workspace state
.vscode/

# Temporary & Swap files
*.swp
*.swo
*.swn
*.bak
*.patch
*.diff

# ------------------------------------------------------------------------------
# 3. Environment & Secrets (Root & Monorepo Defaults)
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
!.env.example
!.env.sample

# Private keys and certificates
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 4. Monorepo Dependencies & Tooling (pnpm & Turborepo)
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Turborepo cache
.turbo/

# Shared build outputs
dist/
build/
out/

# TypeScript composite build info
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 5. Logs, Runtime PIDs, and Diagnostics
# ------------------------------------------------------------------------------
.logs/
*.log
*.pid

# ------------------------------------------------------------------------------
# 6. Testing & Coverage Outputs
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/

# ------------------------------------------------------------------------------
# 7. Local Agent Harness & Workspace Metadata
# ------------------------------------------------------------------------------
.agents/
