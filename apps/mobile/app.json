{
  "expo": {
    "name": "Apex Tire Center",
    "slug": "tire-store-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tirestore",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apextire.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Apex Tire requires your location to display nearby retail stores and available service bays.",
        "NSCameraUsageDescription": "Apex Tire requires camera access to scan vehicle VIN barcodes and tire specs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1117"
      },
      "package": "com.apextire.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Apex Tire to access your location to find nearby stores."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Apex Tire to access your camera to scan vehicle VINs."
        }
      ]
    ]
  }
}

